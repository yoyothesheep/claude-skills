{
  "_comment": "Single source of truth for agent guardrails. Copied to .agent/guardrails.json; scripts/gen_guardrails.py generates each agent's config from it. Edit here, regenerate, and record any change in an ADR.",
  "secret_paths": [
    ".env", ".env.local", ".env.development", ".env.production", ".env.*.local",
    "**/*.pem", "**/*.key", "secrets/**"
  ],
  "protected_paths": [
    ".agent/guardrails.json", ".claude/settings.json", ".claude/hooks/**",
    ".cursorignore", ".geminiignore", ".claude/agents/loop-*.md", ".codex/agents/loop_*.toml",
    ".cursor/hooks.json", ".cursor/agents/loop-*.md", ".codex/hooks.json", ".github/workflows/guardrails.yml"
  ],
  "verifier_bash_allow": [],
  "append_only_paths": ["history/decisions/**", "history/milestones/**"],
  "adr_required_paths": [
    "**/design-system/**", "**/tokens/**", "**/theme.*", "tailwind.config.*",
    "**/styles/globals.css", "**/styles/tokens.css", "src/components/ui/**"
  ],
  "private_data_paths": [
    "**/*.db", "**/*.sqlite", "**/*.sqlite3", "**/*.dump", "**/*.bak",
    "**/backups/**", "**/exports/**", "**/*.csv", "**/*.log"
  ],
  "private_data_allow": ["tests/fixtures/**"],
  "denied_bash_prefixes": ["rm -rf", "git push --force", "git reset --hard", "git clean -f"],
  "denied_bash_patterns": [
    "\\brm\\s+-[a-zA-Z]*(?:rf|fr)\\b",
    "\\bgit\\s+push\\b.*(?:\\s-f\\b|--force)",
    "\\bgit\\s+reset\\s+--hard\\b",
    "\\bgit\\s+clean\\s+-[a-zA-Z]*f",
    "\\bDROP\\s+(?:TABLE|DATABASE|SCHEMA)\\b",
    "\\bTRUNCATE\\s+TABLE\\b",
    "\\bcurl\\b[^|]*\\|\\s*(?:sh|bash)\\b",
    "\\bgit\\s+commit\\b[^|;&]*\\s(?:--no-verify|-[a-zA-Z]*n[a-zA-Z]*)\\b",
    "\\bgit\\s+push\\b[^|;&]*\\s--no-verify\\b",
    "\\bcore\\.hooksPath\\b",
    "\\bterraform\\s+(?:destroy\\b|apply\\b.*\\s-destroy\\b)",
    "\\brailway\\s+(?:down|delete|(?:volume|environment|service|project)\\s+delete)\\b",
    "\\baws\\s+\\S+\\s+(?:delete-\\S+|terminate-\\S+|rb)\\b",
    "\\bgcloud\\b[^|;&]*\\s(?:delete|destroy)\\b",
    "\\bkubectl\\s+delete\\b",
    "\\bfly(?:ctl)?\\b[^|;&]*\\s(?:destroy|delete)\\b",
    "\\bheroku\\s+\\S*destroy\\b",
    "\\bvercel\\s+(?:remove|rm)\\b",
    "\\bnetlify\\s+sites:delete\\b",
    "\\bsupabase\\s+(?:db\\s+reset\\b[^|;&]*--linked|projects\\s+delete)\\b"
  ]
}
